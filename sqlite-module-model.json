{
  "project": "sqlite",
  "source": "https://github.com/sqlite/sqlite",
  "docs": [
    "https://www.sqlite.org/arch.html",
    "https://github.com/sqlite/sqlite/blob/master/README.md"
  ],
  "architecture": "modular_monolith",
  "notes": [
    "SQLite is layered internally but shipped as one library, usually the sqlite3.c amalgamation.",
    "Headers listed as interface are the real module boundaries; files sharing sqliteInt.h are soft-coupled.",
    "Generated files (parse.c, sqlite3.h, opcodes.*, keywordhash.h, pragma.h) are build products, not hand-edited modules.",
    "src/test*.c, tclsqlite.c, and shell.c.in are not part of libsqlite3."
  ],
  "stack": [
    "Interface",
    "SQL Command Processor",
    "Tokenizer",
    "Parser",
    "Code Generator",
    "Virtual Machine (VDBE)",
    "B-Tree",
    "Pager / Page Cache / WAL",
    "OS Interface (VFS)"
  ],
  "data_path": [
    "API",
    "tokenize",
    "parse",
    "resolve",
    "where/select codegen",
    "Vdbe bytecode",
    "btree cursor",
    "pager page",
    "VFS I/O"
  ],
  "modules": [
    {
      "id": "M0",
      "name": "Public API and connection lifecycle",
      "layer": "interface",
      "in_core_library": true,
      "description": "Owns the sqlite3* handle, prepare/step/finalize, configuration, and the C API surface. Only layer applications should call.",
      "interfaces": ["sqlite.h.in", "sqlite3ext.h", "sqliteInt.h", "sqliteLimit.h"],
      "files": [
        "src/sqlite.h.in",
        "src/sqlite3ext.h",
        "src/sqliteInt.h",
        "src/sqliteLimit.h",
        "src/main.c",
        "src/legacy.c",
        "src/prepare.c",
        "src/vdbeapi.c",
        "src/complete.c",
        "src/table.c",
        "src/callback.c",
        "src/loadext.c",
        "src/auth.c",
        "src/status.c",
        "src/notify.c",
        "src/backup.c"
      ],
      "key_types": ["sqlite3", "sqlite3_stmt", "sqlite3_context"],
      "depends_on": ["M1", "M2", "M6"]
    },
    {
      "id": "M1",
      "name": "SQL compiler",
      "layer": "sql_compiler",
      "in_core_library": true,
      "description": "Turns a SQL string into a Vdbe bytecode program. Officially Tokenizer + Parser + Code Generator.",
      "submodules": [
        {
          "id": "M1a",
          "name": "Lexer and parser",
          "description": "Tokenize SQL and parse it with the Lemon-generated LALR(1) parser.",
          "files": [
            "src/tokenize.c",
            "src/parse.y"
          ],
          "generated": ["parse.c", "parse.h", "keywordhash.h"],
          "tools": ["tool/lemon.c", "tool/lempar.c", "tool/mkkeywordhash.c"]
        },
        {
          "id": "M1b",
          "name": "Name resolution, AST walk, schema DDL",
          "description": "Resolve names, walk expression/SELECT trees, and compile schema-changing statements.",
          "files": [
            "src/resolve.c",
            "src/walker.c",
            "src/treeview.c",
            "src/expr.c",
            "src/build.c",
            "src/alter.c",
            "src/analyze.c",
            "src/attach.c",
            "src/vacuum.c",
            "src/pragma.c",
            "src/trigger.c",
            "src/fkey.c",
            "src/vtab.c"
          ],
          "generated": ["pragma.h"],
          "tools": ["tool/mkpragmatab.tcl"]
        },
        {
          "id": "M1c",
          "name": "DML and query planner",
          "description": "SELECT/INSERT/UPDATE/DELETE/UPSERT codegen and the WHERE-clause optimizer.",
          "files": [
            "src/select.c",
            "src/insert.c",
            "src/upsert.c",
            "src/update.c",
            "src/delete.c",
            "src/where.c",
            "src/wherecode.c",
            "src/whereexpr.c",
            "src/whereInt.h",
            "src/window.c",
            "src/rowset.c"
          ],
          "key_types": ["Parse", "Select", "Expr", "WhereInfo", "WhereLoop"]
        }
      ],
      "interfaces": ["src/parse.y", "src/whereInt.h", "src/sqliteInt.h"],
      "depends_on": ["M2", "M6", "M7"]
    },
    {
      "id": "M2",
      "name": "VDBE bytecode virtual machine",
      "layer": "execution",
      "in_core_library": true,
      "description": "Interprets bytecode produced by the compiler. Clean cut between compile and execute. Cursors point at B-tree or virtual-table cursors.",
      "interfaces": ["src/vdbe.h", "src/vdbeInt.h"],
      "files": [
        "src/vdbe.c",
        "src/vdbe.h",
        "src/vdbeInt.h",
        "src/vdbeaux.c",
        "src/vdbemem.c",
        "src/vdbeblob.c",
        "src/vdbesort.c",
        "src/vdbetrace.c",
        "src/vdbevtab.c"
      ],
      "generated": ["opcodes.h", "opcodes.c"],
      "tools": ["tool/mkopcodeh.tcl", "tool/mkopcodec.tcl"],
      "key_types": ["Vdbe", "VdbeOp", "VdbeCursor", "Mem"],
      "depends_on": ["M3", "M6", "M7"]
    },
    {
      "id": "M3",
      "name": "B-tree storage engine",
      "layer": "storage",
      "in_core_library": true,
      "description": "Tables and indexes as B-trees. Owns on-disk cell/page format together with pager page size.",
      "interfaces": ["src/btree.h", "src/btreeInt.h"],
      "files": [
        "src/btree.c",
        "src/btree.h",
        "src/btreeInt.h",
        "src/btmutex.c"
      ],
      "key_types": ["Btree", "BtShared", "BtCursor", "MemPage"],
      "depends_on": ["M4", "M6"]
    },
    {
      "id": "M4",
      "name": "Pager, page cache, and WAL",
      "layer": "storage",
      "in_core_library": true,
      "description": "Transactions, commit/rollback, page cache, rollback journal and WAL. ACID lives here, not in the B-tree.",
      "interfaces": ["src/pager.h", "src/pcache.h", "src/wal.h"],
      "files": [
        "src/pager.c",
        "src/pager.h",
        "src/wal.c",
        "src/wal.h",
        "src/pcache.c",
        "src/pcache.h",
        "src/pcache1.c",
        "src/bitvec.c",
        "src/memjournal.c"
      ],
      "key_types": ["Pager", "PgHdr", "PCache", "Wal"],
      "depends_on": ["M5", "M6"]
    },
    {
      "id": "M5",
      "name": "VFS / OS interface",
      "layer": "os",
      "in_core_library": true,
      "description": "Portable file and OS abstraction. Core never calls read()/WriteFile directly; new platforms plug in sqlite3_vfs.",
      "interfaces": ["src/os.h", "sqlite3_vfs", "sqlite3_io_methods"],
      "files": [
        "src/os.c",
        "src/os.h",
        "src/os_common.h",
        "src/os_setup.h",
        "src/os_unix.c",
        "src/os_win.c",
        "src/os_win.h",
        "src/os_kv.c",
        "src/vxworks.h",
        "src/memdb.c"
      ],
      "key_types": ["sqlite3_vfs", "sqlite3_file", "sqlite3_io_methods"],
      "depends_on": ["M6"]
    },
    {
      "id": "M6",
      "name": "Runtime services",
      "layer": "cross_cutting",
      "in_core_library": true,
      "description": "Memory, mutexes, strings, Unicode, hashing, PRNG, globals. Used by every other core module.",
      "submodules": [
        {
          "id": "M6a",
          "name": "Memory and concurrency",
          "files": [
            "src/malloc.c",
            "src/mem0.c",
            "src/mem1.c",
            "src/mem2.c",
            "src/mem3.c",
            "src/mem5.c",
            "src/mutex.c",
            "src/mutex.h",
            "src/mutex_noop.c",
            "src/mutex_unix.c",
            "src/mutex_w32.c",
            "src/threads.c",
            "src/fault.c"
          ]
        },
        {
          "id": "M6b",
          "name": "Values, text, randomness",
          "files": [
            "src/util.c",
            "src/utf.c",
            "src/printf.c",
            "src/hash.c",
            "src/hash.h",
            "src/random.c",
            "src/hwtime.h",
            "src/global.c",
            "src/msvc.h"
          ]
        }
      ],
      "files": [
        "src/malloc.c",
        "src/mem0.c",
        "src/mem1.c",
        "src/mem2.c",
        "src/mem3.c",
        "src/mem5.c",
        "src/mutex.c",
        "src/mutex.h",
        "src/mutex_noop.c",
        "src/mutex_unix.c",
        "src/mutex_w32.c",
        "src/threads.c",
        "src/fault.c",
        "src/util.c",
        "src/utf.c",
        "src/printf.c",
        "src/hash.c",
        "src/hash.h",
        "src/random.c",
        "src/hwtime.h",
        "src/global.c",
        "src/msvc.h"
      ],
      "depends_on": []
    },
    {
      "id": "M7",
      "name": "Built-in SQL functions and core virtual tables",
      "layer": "sql_runtime",
      "in_core_library": true,
      "description": "Callback implementations the VM and schema invoke. Some functions (typeof, coalesce) are compiled directly to bytecode in M1 instead.",
      "files": [
        "src/func.c",
        "src/date.c",
        "src/json.c",
        "src/carray.c",
        "src/dbpage.c",
        "src/dbstat.c"
      ],
      "depends_on": ["M2", "M6"]
    },
    {
      "id": "M8",
      "name": "Optional extensions",
      "layer": "extensions",
      "in_core_library": false,
      "description": "Sit beside the core via the virtual-table and loadable-extension APIs. Some (FTS, RTREE) may be compiled into the amalgamation.",
      "interfaces": ["src/sqlite3ext.h", "src/vtab.c", "src/loadext.c"],
      "extensions": [
        {"dir": "ext/fts3", "name": "FTS3/FTS4 full-text search", "often_in_amalgamation": true},
        {"dir": "ext/fts5", "name": "FTS5 full-text search", "often_in_amalgamation": true},
        {"dir": "ext/rtree", "name": "R-tree spatial index", "often_in_amalgamation": true},
        {"dir": "ext/session", "name": "Session / changeset", "often_in_amalgamation": false},
        {"dir": "ext/rbu", "name": "Resumable bulk update", "often_in_amalgamation": false},
        {"dir": "ext/icu", "name": "ICU collation and regex", "often_in_amalgamation": false},
        {"dir": "ext/recover", "name": "Database recovery", "often_in_amalgamation": false},
        {"dir": "ext/expert", "name": "Index advisor", "often_in_amalgamation": false},
        {"dir": "ext/intck", "name": "Integrity cross-check", "often_in_amalgamation": false},
        {"dir": "ext/misc", "name": "One-file extensions (regexp, csv, series, ...)", "often_in_amalgamation": false},
        {"dir": "ext/jni", "name": "JNI bindings", "often_in_amalgamation": false},
        {"dir": "ext/wasm", "name": "WebAssembly bindings", "often_in_amalgamation": false},
        {"dir": "ext/qrf", "name": "Query result formatter", "often_in_amalgamation": false}
      ],
      "depends_on": ["M0", "M7"]
    },
    {
      "id": "M9",
      "name": "Shell, bindings, tests, and build plane",
      "layer": "out_of_library",
      "in_core_library": false,
      "description": "Not part of libsqlite3. CLI, Tcl binding, testfixture sources, and code-generation tools.",
      "submodules": [
        {
          "id": "M9a",
          "name": "CLI and bindings",
          "files": ["src/shell.c.in", "src/tclsqlite.c", "src/tclsqlite.h", "src/sqlite3.rc"]
        },
        {
          "id": "M9b",
          "name": "In-tree test C",
          "files_glob": "src/test*.c",
          "notes": "Linked into testfixture, not the library."
        },
        {
          "id": "M9c",
          "name": "Test scripts and extra test code",
          "dirs": ["test/", "mptest/"]
        },
        {
          "id": "M9d",
          "name": "Codegen and packaging tools",
          "files": [
            "tool/lemon.c",
            "tool/lempar.c",
            "tool/mksqlite3h.tcl",
            "tool/mksqlite3c.tcl",
            "tool/split-sqlite3c.tcl",
            "tool/mkopcodeh.tcl",
            "tool/mkopcodec.tcl",
            "tool/mkkeywordhash.c",
            "tool/mkpragmatab.tcl"
          ],
          "generated_artifacts": [
            "sqlite3.h",
            "parse.c",
            "parse.h",
            "opcodes.h",
            "opcodes.c",
            "keywordhash.h",
            "pragma.h",
            "sqlite3.c",
            "sqlite3-all.c"
          ]
        }
      ],
      "depends_on": ["M0"]
    }
  ],
  "hard_boundaries": [
    {"header": "vdbe.h", "from": "rest of core", "to": "M2 VDBE"},
    {"header": "btree.h", "from": "VM / schema", "to": "M3 B-tree"},
    {"header": "pager.h", "from": "B-tree", "to": "M4 pager"},
    {"header": "os.h / sqlite3_vfs", "from": "pager", "to": "M5 VFS"},
    {"header": "pcache.h", "from": "pager", "to": "page cache implementation"},
    {"header": "sqlite3ext.h", "from": "core", "to": "M8 loadable modules"}
  ],
  "soft_boundaries": [
    "Tokenizer, parser actions, and code generator share Parse and sqliteInt.h",
    "expr.c <-> select.c <-> where.c",
    "Built-in functions vs code generator for some SQL functions",
    "JSON / window / vtab code straddles compiler and runtime"
  ],
  "repo_layout": {
    "src/": "Primary core C sources; also test*.c, tclsqlite, and shell.c.in",
    "ext/": "Optional extensions",
    "test/": "TCL test scripts and extra test programs",
    "tool/": "Lemon, header/amalgamation generators, diagnostics",
    "doc/": "Internal docs; user docs live in a separate repo",
    "autoconf/": "Autotools / packaging",
    "contrib/": "Contributed extras"
  }
}
