# Build mruby with AddressSanitizer and UndefinedBehaviorSanitizer enabled.
#
# Example:
#   docker build -f Dockerfile.mruby -t taxoshop/mruby-asan-ubsan:current .
#   docker run --rm taxoshop/mruby-asan-ubsan:current /src/mruby/build/host/bin/mruby -e '1 + 1 == 2 or exit 1'
# Ubuntu 25.04 carries an archive keyring that verifies current Ubuntu Release
# signatures.  The available 24.04 base image in this environment has a stale
# keyring and fails at `apt-get update` before the mruby build can start.
FROM ubuntu:25.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MRUBY_REF=master

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bison \
        build-essential \
        ca-certificates \
        clang \
        git \
        libclang-rt-20-dev \
        rake \
        ruby \
        llvm-20 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN git clone --depth 1 --branch "${MRUBY_REF}" https://github.com/mruby/mruby.git

WORKDIR /src/mruby

# Keep the sanitizer configuration in the image build so this Dockerfile remains
# self-contained.  Both compiler and linker flags are necessary: the latter links
# the ASan/UBSan runtimes into the resulting mruby executable.
RUN printf '%s\n' \
        'MRuby::Build.new do |conf|' \
        '  conf.toolchain :clang' \
        '  sanitizer_flags = %w[-fsanitize=address,undefined -fno-omit-frame-pointer -g]' \
        '  conf.cc.flags.concat sanitizer_flags' \
        '  conf.linker.flags.concat sanitizer_flags' \
        "  conf.gembox 'default'" \
        'end' \
        > /tmp/asan-ubsan.rb \
    && rake MRUBY_CONFIG=/tmp/asan-ubsan.rb \
    && rm /tmp/asan-ubsan.rb

ENV ASAN_OPTIONS=detect_leaks=0:abort_on_error=1:symbolize=1
ENV UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1
ENV ASAN_SYMBOLIZER_PATH=/usr/bin/llvm-symbolizer-20
ENV LLVM_SYMBOLIZER_PATH=/usr/bin/llvm-symbolizer-20

CMD ["/src/mruby/build/host/bin/mruby"]
