      "blob_url": "https://github.com/python/cpython/blob/9db06a47303cb76cad12a4ea7eefd66168e4f5eb/Objects%2Fdictobject.c",
      "raw_url": "https://github.com/python/cpython/raw/9db06a47303cb76cad12a4ea7eefd66168e4f5eb/Objects%2Fdictobject.c",
