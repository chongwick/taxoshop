    "title": "gh-142884: Fix use-after-free in array.array.tofile() with reentrant writer",
    "user": {
      "login": "raminfp",
      "id": 10054759,
      "node_id": "MDQ6VXNlcjEwMDU0NzU5",
      "avatar_url": "https://avatars.githubusercontent.com/u/10054759?v=4",
