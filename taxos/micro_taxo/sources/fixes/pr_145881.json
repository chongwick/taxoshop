      "patch": "@@ -91,6 +91,27 @@ def copy_back_and_forth(b, l):\n         with threading_helper.start_threads(threads):\n             pass\n \n+    # gh-145036: race condition with list.__sizeof__()\n+    def test_list_sizeof_free_threaded_build(self):\n+        L = []\n+\n+        def mutate_function():\n+            for _ in range(100):\n+                L.append(1)\n+                L.pop()\n+\n+        def size_function():\n+            for _ in range(100):\n+                L.__sizeof__()\n+\n+        threads = []\n+        for _ in range(4):\n+            threads.append(Thread(target=mutate_function))\n+            threads.append(Thread(target=size_function))\n+\n+        with threading_helper.start_threads(threads):\n+            pass\n+\n \n if __name__ == \"__main__\":\n     unittest.main()"
