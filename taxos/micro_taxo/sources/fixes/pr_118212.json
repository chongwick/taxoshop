l have set a None default on the class\n             }\n@@ -5225,8 +5229,7 @@ ast_type_init(PyObject *self, PyObject *args, PyObject *kw)\n                     \"This will become an error in Python 3.15.\",\n                     Py_TYPE(self)->tp_name, name\n                 ) < 0) {\n-                    res = -1;\n-                    goto cleanup;\n+                    goto set_remaining_cleanup;\n                 }\n             }\n         }"
