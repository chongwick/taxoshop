      "deletions": 8,
      "changes": 17,
      "blob_url": "https://github.com/python/cpython/blob/f778f01264caecd3cfe03458ef863fa65bf4c539/Lib%2Ftest%2Ftest_gc.py",
      "raw_url": "https://github.com/python/cpython/raw/f778f01264caecd3cfe03458ef863fa65bf4c539/Lib%2Ftest%2Ftest_gc.py",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Lib%2Ftest%2Ftest_gc.py?ref=f778f01264caecd3cfe03458ef863fa65bf4c539",
      "patch": "@@ -1390,10 +1390,11 @@ def callback(ignored):\n             # The free-threaded build doesn't have multiple generations, so\n             # just trigger a GC manually.\n             gc.collect()\n+        assert not detector.gc_happened\n         while not detector.gc_happened:\n             i += 1\n-            if i > 10000:\n-                self.fail(\"gc didn't happen after 10000 iterations\")\n+            if i > 100000:\n+                self.fail(\"gc didn't happen after 100000 iterations\")\n             self.assertEqual(len(ouch), 0)\n             junk.append([])  # this will eventually trigger gc\n \n@@ -1464,8 +1465,8 @@ def __del__(self):\n             gc.collect()\n         while not detector.gc_happened:\n             i += 1\n-            if i > 10000:\n-                self.fail(\"gc didn't happen after 10000 iterations\")\n+            if i > 50000:\n+                self.fail(\"gc didn't happen after 50000 iterations\")\n             self.assertEqual(len(ouch), 0)\n             junk.append([])  # this will eventually trigger gc\n \n@@ -1482,8 +1483,8 @@ def test_indirect_calls_with_gc_disabled(self):\n         detector = GC_Detector()\n         while not detector.gc_happened:\n             i += 1\n-            if i > 10000:\n-                self.fail(\"gc didn't happen after 10000 iterations\")\n+            if i > 100000:\n+                self.fail(\"gc didn't happen after 100000 iterations\")\n             junk.append([])  # this will eventually trigger gc\n \n         try:\n@@ -1493,11 +1494,11 @@ def test_indirect_calls_with_gc_disabled(self):\n             detector = GC_Detector()\n             while not detector.gc_happened:\n                 i += 1\n-                if i > 10000:\n+                if i > 100000:\n                     break\n                 junk.append([])  # this may eventually trigger gc (if it is enabled)\n \n-            self.assertEqual(i, 10001)\n+            self.assertEqual(i, 100001)\n         finally:\n             gc.enable()\n "
    },
