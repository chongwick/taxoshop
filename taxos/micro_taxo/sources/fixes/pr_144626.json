      "patch": "@@ -0,0 +1,2 @@\n+Fix a crash in itertools.groupby that could occur when a user-defined\n+:meth:`~object.__eq__` method re-enters the iterator during key comparison."
    },
    {
      "sha": "fd03fae03f92113ae1b7f3f4df6cdb0a22e4d950",
      "filename": "Modules/itertoolsmodule.c",
      "status": "modified",
      "additions": 12,
      "deletions": 2,
      "changes": 14,
      "blob_url": "https://github.com/python/cpython/blob/97ea525bf7abbced1d724e89659950e69b3d4ade/Modules%2Fitertoolsmodule.c",
      "raw_url": "https://github.com/python/cpython/raw/97ea525bf7abbced1d724e89659950e69b3d4ade/Modules%2Fitertoolsmodule.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Modules%2Fitertoolsmodule.c?ref=97ea525bf7abbced1d724e89659950e69b3d4ade",
      "patch": "@@ -544,9 +544,19 @@ groupby_next(PyObject *op)\n         else if (gbo->tgtkey == NULL)\n             break;\n         else {\n-            int rcmp;\n+            /* A user-defined __eq__ can re-enter groupby and advance the iterator,\n+               mutating gbo->tgtkey / gbo->currkey while we are comparing them.\n+               Take local snapshots and hold strong references so INCREF/DECREF\n+               apply to the same objects even under re-entrancy. */\n+            PyObject *tgtkey = gbo->tgtkey;\n+            PyObject *currkey = gbo->currkey;\n+\n+            Py_INCREF(tgtkey);\n+            Py_INCREF(currkey);\n+            int rcmp = PyObject_RichCompareBool(tgtkey, currkey, Py_EQ);\n+            Py_DECREF(tgtkey);\n+            Py_DECREF(currkey);\n \n-            rcmp = PyObject_RichCompareBool(gbo->tgtkey, gbo->currkey, Py_EQ);\n             if (rcmp == -1)\n                 return NULL;\n             else if (rcmp == 0)"
    }
