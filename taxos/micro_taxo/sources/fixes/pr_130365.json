      "blob_url": "https://github.com/python/cpython/blob/34ac3fea76dd6cb5f451103d2e6a0bf7b8b57c37/Modules%2Ffaulthandler.c",
      "raw_url": "https://github.com/python/cpython/raw/34ac3fea76dd6cb5f451103d2e6a0bf7b8b57c37/Modules%2Ffaulthandler.c",
