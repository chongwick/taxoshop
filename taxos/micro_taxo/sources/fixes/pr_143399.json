      "sha": "5f30ed340bf0ebb0ebb756831e7f440caf2a1bb7",
      "filename": "Misc/NEWS.d/next/Library/2025-12-31-20-43-02.gh-issue-143309.cdFxdH.rst",
      "status": "added",
      "additions": 3,
