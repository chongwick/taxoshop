      "patch": "@@ -0,0 +1,2 @@\n+Fix a heap-use-after-free in the C implementation of :mod:`decimal`\n+when calling :func:`repr` after deleting the :class:`~decimal.Context`."
    },
    {
      "sha": "8590efd1fabe52abbc128fdbad76d14e0619a914",
      "filename": "Modules/_decimal/_decimal.c",
      "status": "modified",
      "additions": 14,
      "deletions": 0,
      "changes": 14,
      "blob_url": "https://github.com/python/cpython/blob/d94c6659dd9359644cc4b0de4a13d47d33088710/Modules%2F_decimal%2F_decimal.c",
      "raw_url": "https://github.com/python/cpython/raw/d94c6659dd9359644cc4b0de4a13d47d33088710/Modules%2F_decimal%2F_decimal.c",
