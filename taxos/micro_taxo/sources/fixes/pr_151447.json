      "raw_url": "https://github.com/python/cpython/raw/7964840bc8c70d5dc4b81eb0a7cc994ebbf01fe4/Misc%2FNEWS.d%2Fnext%2FLibrary%2F2026-06-12-22-46-31.gh-issue-151403.DalZWh.rst",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Misc%2FNEWS.d%2Fnext%2FLibrary%2F2026-06-12-22-46-31.gh-issue-151403.DalZWh.rst?ref=7964840bc8c70d5dc4b81eb0a7cc994ebbf01fe4",
      "patch": "@@ -0,0 +1,3 @@\n+Fixed a crash in :class:`subprocess.Popen` (and ``_posixsubprocess.fork_exec``)\n+when an ``argv`` item's :meth:`~os.PathLike.__fspath__` concurrently mutates the\n+``args`` sequence being converted."
    },
    {
      "sha": "745160ec340e22356adfb03ad60d448905f9b9c1",
      "filename": "Modules/_posixsubprocess.c",
      "status": "modified",
      "additions": 7,
      "deletions": 1,
      "changes": 8,
      "blob_url": "https://github.com/python/cpython/blob/7964840bc8c70d5dc4b81eb0a7cc994ebbf01fe4/Modules%2F_posixsubprocess.c",
      "raw_url": "https://github.com/python/cpython/raw/7964840bc8c70d5dc4b81eb0a7cc994ebbf01fe4/Modules%2F_posixsubprocess.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Modules%2F_posixsubprocess.c?ref=7964840bc8c70d5dc4b81eb0a7cc994ebbf01fe4",
      "patch": "@@ -1089,8 +1089,14 @@ subprocess_fork_exec_impl(PyObject *module, PyObject *process_args,\n                 goto cleanup;\n             }\n             borrowed_arg = PySequence_Fast_GET_ITEM(fast_args, arg_num);\n-            if (PyUnicode_FSConverter(borrowed_arg, &converted_arg) == 0)\n+            /* borrowed_arg is only borrowed; its __fspath__() may run Python\n+               that drops fast_args' last reference to it. */\n+            Py_INCREF(borrowed_arg);\n+            if (PyUnicode_FSConverter(borrowed_arg, &converted_arg) == 0) {\n+                Py_DECREF(borrowed_arg);\n                 goto cleanup;\n+            }\n+            Py_DECREF(borrowed_arg);\n             PyTuple_SET_ITEM(converted_args, arg_num, converted_arg);\n         }\n "
    }
