    "title": "gh-153852: Fix data race in hash cal for Decimal",
    "user": {
      "login": "weixlu",
      "id": 39413832,
      "node_id": "MDQ6VXNlcjM5NDEzODMy",
      "avatar_url": "https://avatars.githubusercontent.com/u/39413832?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/weixlu",
      "html_url": "https://github.com/weixlu",
      "followers_url": "https://api.github.com/users/weixlu/followers",
      "following_url": "https://api.github.com/users/weixlu/following{/other_user}",
      "gists_url": "https://api.github.com/users/weixlu/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/weixlu/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/weixlu/subscriptions",
      "organizations_url": "https://api.github.com/users/weixlu/orgs",
      "repos_url": "https://api.github.com/users/weixlu/repos",
