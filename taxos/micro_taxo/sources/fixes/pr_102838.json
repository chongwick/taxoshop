      "patch": "@@ -0,0 +1,2 @@\n+Ignore acceptable access of an uninitialized value to fix building\n+``--with-memory-sanitizer``. Patch by Illia Volochii."
    },
    {
      "sha": "798ad7f14f65fc49e4218cb9f4e7729538a73c88",
      "filename": "Misc/README",
      "status": "modified",
      "additions": 1,
      "deletions": 0,
      "changes": 1,
      "blob_url": "https://github.com/python/cpython/blob/30bd44ccb1d0622971948e0760e4e8232a6851fc/Misc%2FREADME",
      "raw_url": "https://github.com/python/cpython/raw/30bd44ccb1d0622971948e0760e4e8232a6851fc/Misc%2FREADME",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Misc%2FREADME?ref=30bd44ccb1d0622971948e0760e4e8232a6851fc",
      "patch": "@@ -19,6 +19,7 @@ README                  The file you're reading now\n README.AIX              Information about using Python on AIX\n README.coverity         Information about running Coverity's Prevent on Python\n README.valgrind         Information for Valgrind users, see valgrind-python.supp\n+sanitize-ignorelist.txt Entities to be ignored by sanitizers\n SpecialBuilds.txt       Describes extra symbols you can set for debug builds\n svnmap.txt              Map of old SVN revs and branches to hg changeset ids,\n                         help history-digging"
    },
    {
      "sha": "ae39f572cfb21633f95229f663eb5c4d9429969a",
      "filename": "Misc/sanitize-ignorelist.txt",
      "status": "added",
      "additions": 12,
      "deletions": 0,
      "changes": 12,
      "blob_url": "https://github.com/python/cpython/blob/30bd44ccb1d0622971948e0760e4e8232a6851fc/Misc%2Fsanitize-ignorelist.txt",
      "raw_url": "https://github.com/python/cpython/raw/30bd44ccb1d0622971948e0760e4e8232a6851fc/Misc%2Fsanitize-ignorelist.txt",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Misc%2Fsanitize-ignorelist.txt?ref=30bd44ccb1d0622971948e0760e4e8232a6851fc",
      "patch": "@@ -0,0 +1,12 @@\n+#\n+# This is a file listing entities to be ignored by sanitizers.\n+# https://clang.llvm.org/docs/SanitizerSpecialCaseList.html\n+#\n+\n+[memory]\n+# medium_value called by maybe_small_long accesses an uninitialized\n+# integer in the case of PyLong of size 0, but the integer is then\n+# multiplied by zero immediately, so the lack of initialisation has no\n+# adverse effect.\n+# https://github.com/python/cpython/issues/102509\n+fun:maybe_small_long"
    },
    {
      "sha": "8b0bd636fd75bf9536cdea7b00ec27143a7c4e5b",
      "filename": "configure",
      "status": "modified",
      "additions": 2,
      "deletions": 2,
      "changes": 4,
      "blob_url": "https://github.com/python/cpython/blob/30bd44ccb1d0622971948e0760e4e8232a6851fc/configure",
      "raw_url": "https://github.com/python/cpython/raw/30bd44ccb1d0622971948e0760e4e8232a6851fc/configure",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/configure?ref=30bd44ccb1d0622971948e0760e4e8232a6851fc",
      "patch": "@@ -11330,8 +11330,8 @@ fi\n $as_echo \"$ax_cv_check_cflags___fsanitize_memory\" >&6; }\n if test \"x$ax_cv_check_cflags___fsanitize_memory\" = xyes; then :\n \n-BASECFLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer $BASECFLAGS\"\n-LDFLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2 $LDFLAGS\"\n+BASECFLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer -fsanitize-ignorelist=Misc/sanitize-ignorelist.txt $BASECFLAGS\"\n+LDFLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2 -fsanitize-ignorelist=Misc/sanitize-ignorelist.txt $LDFLAGS\"\n \n else\n   as_fn_error $? \"The selected compiler doesn't support memory sanitizer\" \"$LINENO\" 5"
    },
    {
      "sha": "36d63eded9128954f6870db68506d639a6a260d3",
      "filename": "configure.ac",
      "status": "modified",
      "additions": 2,
      "deletions": 2,
      "changes": 4,
      "blob_url": "https://github.com/python/cpython/blob/30bd44ccb1d0622971948e0760e4e8232a6851fc/configure.ac",
      "raw_url": "https://github.com/python/cpython/raw/30bd44ccb1d0622971948e0760e4e8232a6851fc/configure.ac",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/configure.ac?ref=30bd44ccb1d0622971948e0760e4e8232a6851fc",
      "patch": "@@ -3102,8 +3102,8 @@ AC_ARG_WITH(memory_sanitizer,\n [\n AC_MSG_RESULT($withval)\n AX_CHECK_COMPILE_FLAG([-fsanitize=memory],[\n-BASECFLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer $BASECFLAGS\"\n-LDFLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2 $LDFLAGS\"\n+BASECFLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer -fsanitize-ignorelist=Misc/sanitize-ignorelist.txt $BASECFLAGS\"\n+LDFLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2 -fsanitize-ignorelist=Misc/sanitize-ignorelist.txt $LDFLAGS\"\n ],[AC_MSG_ERROR([The selected compiler doesn't support memory sanitizer])])\n # MSan works by controlling memory allocation, our own malloc interferes.\n with_pymalloc=\"no\""
    }
