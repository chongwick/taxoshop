      "patch": "@@ -0,0 +1,2 @@\n+Fix data race between interpreter_clear() and take_gil() on eval_breaker\n+during finalization with daemon threads."
    },
    {
      "sha": "9f6e961e71ae9ff1269d10186a22a2472d7dae60",
      "filename": "Python/pystate.c",
      "status": "modified",
      "additions": 4,
      "deletions": 3,
      "changes": 7,
      "blob_url": "https://github.com/python/cpython/blob/f864c6c12951ab32f08b211f923647b70611a6f9/Python%2Fpystate.c",
      "raw_url": "https://github.com/python/cpython/raw/f864c6c12951ab32f08b211f923647b70611a6f9/Python%2Fpystate.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Python%2Fpystate.c?ref=f864c6c12951ab32f08b211f923647b70611a6f9",
      "patch": "@@ -860,10 +860,11 @@ interpreter_clear(PyInterpreterState *interp, PyThreadState *tstate)\n \n     Py_CLEAR(interp->audit_hooks);\n \n-    // At this time, all the threads should be cleared so we don't need atomic\n-    // operations for instrumentation_version or eval_breaker.\n+    // gh-140257: Threads have already been cleared, but daemon threads may\n+    // still access eval_breaker atomically via take_gil() right before they\n+    // hang. Use an atomic store to prevent data races during finalization.\n     interp->ceval.instrumentation_version = 0;\n-    tstate->eval_breaker = 0;\n+    _Py_atomic_store_uintptr(&tstate->eval_breaker, 0);\n \n     for (int i = 0; i < _PY_MONITORING_UNGROUPED_EVENTS; i++) {\n         interp->monitors.tools[i] = 0;"
    }
