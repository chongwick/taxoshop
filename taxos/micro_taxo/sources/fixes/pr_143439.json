  "files": [
    {
      "sha": "12b5ebc89aeec78341f6e8a53172c8e934ce22fb",
      "filename": "Python/lock.c",
      "status": "modified",
      "additions": 5,
      "deletions": 2,
      "changes": 7,
      "blob_url": "https://github.com/python/cpython/blob/f05bded56fbf01c20e429cd054a06f13ca12a431/Python%2Flock.c",
      "raw_url": "https://github.com/python/cpython/raw/f05bded56fbf01c20e429cd054a06f13ca12a431/Python%2Flock.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Python%2Flock.c?ref=f05bded56fbf01c20e429cd054a06f13ca12a431",
      "patch": "@@ -124,8 +124,11 @@ _PyMutex_LockTimed(PyMutex *m, PyTime_t timeout, _PyLockFlags flags)\n                                      &entry, (flags & _PY_LOCK_DETACH) != 0);\n         if (ret == Py_PARK_OK) {\n             if (entry.handed_off) {\n-                // We own the lock now.\n-                assert(_Py_atomic_load_uint8_relaxed(&m->_bits) & _Py_LOCKED);\n+                // We own the lock now. thread.Lock allows other threads\n+                // to concurrently release the lock so we cannot assert that\n+                // it is locked if _PY_LOCK_PYTHONLOCK is set.\n+                assert(_Py_atomic_load_uint8_relaxed(&m->_bits) & _Py_LOCKED ||\n+                       (flags & _PY_LOCK_PYTHONLOCK) != 0);\n                 return PY_LOCK_ACQUIRED;\n             }\n         }"
    }
  ],
