      "blob_url": "https://github.com/python/cpython/blob/c1e2a6eb62c4271431d2455281b5b10d9aa3f1c2/Misc%2FNEWS.d%2Fnext%2FCore_and_Builtins%2F2025-10-22-17-22-22.gh-issue-140431.m8D_A-.rst",
      "raw_url": "https://github.com/python/cpython/raw/c1e2a6eb62c4271431d2455281b5b10d9aa3f1c2/Misc%2FNEWS.d%2Fnext%2FCore_and_Builtins%2F2025-10-22-17-22-22.gh-issue-140431.m8D_A-.rst",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Misc%2FNEWS.d%2Fnext%2FCore_and_Builtins%2F2025-10-22-17-22-22.gh-issue-140431.m8D_A-.rst?ref=c1e2a6eb62c4271431d2455281b5b10d9aa3f1c2",
      "patch": "@@ -0,0 +1,3 @@\n+Fix a crash in Python's :term:`garbage collector <garbage collection>` due to\n+partially initialized :term:`coroutine` objects when coroutine origin tracking\n+depth is enabled (:func:`sys.set_coroutine_origin_tracking_depth`)."
    },
    {
      "sha": "2371ad16d5c1a666e2f4cc2fcdda7b6f3feefb8a",
      "filename": "Objects/genobject.c",
      "status": "modified",
      "additions": 1,
      "deletions": 0,
      "changes": 1,
      "blob_url": "https://github.com/python/cpython/blob/c1e2a6eb62c4271431d2455281b5b10d9aa3f1c2/Objects%2Fgenobject.c",
      "raw_url": "https://github.com/python/cpython/raw/c1e2a6eb62c4271431d2455281b5b10d9aa3f1c2/Objects%2Fgenobject.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Objects%2Fgenobject.c?ref=c1e2a6eb62c4271431d2455281b5b10d9aa3f1c2",
      "patch": "@@ -932,6 +932,7 @@ make_gen(PyTypeObject *type, PyFunctionObject *func)\n     gen->gi_weakreflist = NULL;\n     gen->gi_exc_state.exc_value = NULL;\n     gen->gi_exc_state.previous_item = NULL;\n+    gen->gi_iframe.f_executable = PyStackRef_None;\n     assert(func->func_name != NULL);\n     gen->gi_name = Py_NewRef(func->func_name);\n     assert(func->func_qualname != NULL);"
    }
