    "locked": false,
    "title": "gh-151722: Defer GC tracking of frozendict.fromkeys() result until fully built",
    "user": {
      "login": "tonghuaroot",
      "id": 23011166,
      "node_id": "MDQ6VXNlcjIzMDExMTY2",
      "avatar_url": "https://avatars.githubusercontent.com/u/23011166?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/tonghuaroot",
      "html_url": "https://github.com/tonghuaroot",
      "followers_url": "https://api.github.com/users/tonghuaroot/followers",
      "following_url": "https://api.github.com/users/tonghuaroot/following{/other_user}",
