      "patch": "@@ -0,0 +1,2 @@\n+Fix a bug that caused the tokenizer to not correctly identify mismatched\n+parentheses inside f-strings in some situations. Patch by Pablo Galindo"
    },
    {
      "sha": "c66f753f7d4f89898fbccfa3ef5c0964d7f99e54",
      "filename": "Parser/lexer/lexer.c",
      "status": "modified",
      "additions": 3,
      "deletions": 0,
      "changes": 3,
      "blob_url": "https://github.com/python/cpython/blob/001d9ed9a2537f7a7835aaf5c53ffd3119a3f6a2/Parser%2Flexer%2Flexer.c",
