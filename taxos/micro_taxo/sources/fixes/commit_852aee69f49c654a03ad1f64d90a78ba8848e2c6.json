      "contents_url": "https://api.github.com/repos/python/cpython/contents/Python%2Fpystate.c?ref=852aee69f49c654a03ad1f64d90a78ba8848e2c6",
      "patch": "@@ -411,12 +411,12 @@ new_threadstate(PyInterpreterState *interp, int init)\n         tstate->context = NULL;\n         tstate->context_ver = 1;\n \n-        tstate->id = ++interp->tstate_next_unique_id;\n \n         if (init)\n             _PyThreadState_Init(tstate);\n \n         HEAD_LOCK();\n+        tstate->id = ++interp->tstate_next_unique_id;\n         tstate->prev = NULL;\n         tstate->next = interp->tstate_head;\n         if (tstate->next)"
    }
