      "raw_url": "https://github.com/python/cpython/raw/f612b1af821b94bc8eb085bb932a1788227ee5b9/Misc%2FNEWS.d%2Fnext%2FCore_and_Builtins%2F2026-07-24-13-15-31.gh-issue-153809.JFA6GT.rst",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Misc%2FNEWS.d%2Fnext%2FCore_and_Builtins%2F2026-07-24-13-15-31.gh-issue-153809.JFA6GT.rst?ref=f612b1af821b94bc8eb085bb932a1788227ee5b9",
      "patch": "@@ -0,0 +1,2 @@\n+Fix interpreter crash while deallocating objects of :class:`asyncio.Task` on\n+free-threaded builds. Contributed by Sergey Miryanov."
    },
    {
      "sha": "9c29eb8232ed3f927be18ad5e17f783bcf52e541",
      "filename": "Modules/_asynciomodule.c",
      "status": "modified",
      "additions": 6,
      "deletions": 2,
      "changes": 8,
      "blob_url": "https://github.com/python/cpython/blob/f612b1af821b94bc8eb085bb932a1788227ee5b9/Modules%2F_asynciomodule.c",
      "raw_url": "https://github.com/python/cpython/raw/f612b1af821b94bc8eb085bb932a1788227ee5b9/Modules%2F_asynciomodule.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Modules%2F_asynciomodule.c?ref=f612b1af821b94bc8eb085bb932a1788227ee5b9",
      "patch": "@@ -2966,13 +2966,17 @@ TaskObj_dealloc(PyObject *self)\n     if (PyObject_CallFinalizerFromDealloc(self) < 0) {\n         return; // resurrected\n     }\n+    // Untrack the object before unregistering the task, since the\n+    // latter can cause a stop-the-world pause, after which another\n+    // thread might call the GC and reach the object while it is\n+    // semi-deallocated but still tracked\n+    PyObject_GC_UnTrack(self);\n+\n     // unregister the task after finalization so that\n     // if the task gets resurrected, it remains registered\n     unregister_task((TaskObj *)self);\n \n     PyTypeObject *tp = Py_TYPE(self);\n-    PyObject_GC_UnTrack(self);\n-\n     PyObject_ClearWeakRefs(self);\n \n     (void)TaskObj_clear(self);"
    }
  ],
