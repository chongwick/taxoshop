      "raw_url": "https://github.com/python/cpython/raw/d3a8e474c2eb3bb3b5befba4f9d2d0af291b2040/Modules%2F_threadmodule.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Modules%2F_threadmodule.c?ref=d3a8e474c2eb3bb3b5befba4f9d2d0af291b2040",
      "patch": "@@ -385,6 +385,21 @@ thread_run(void *boot_raw)\n     PyEval_AcquireThread(tstate);\n     _Py_atomic_add_ssize(&tstate->interp->threads.count, 1);\n \n+#ifdef Py_GIL_DISABLED\n+    // See gh-149816 - (62) Concurrent kwargs growth causes heap overwrite\n+    // So duplicate boot->kwargs to ensure that it won't be mutated concurrently\n+    // by the caller.\n+    if (boot->kwargs != NULL) {\n+        PyObject *n_kwargs = PyDict_Copy(boot->kwargs);\n+        if (n_kwargs == NULL) {\n+            thread_bootstate_free(boot, 1);\n+            goto exit;\n+        }\n+        Py_DECREF(boot->kwargs); // I am not pretty sure about this.\n+        boot->kwargs = n_kwargs;\n+    }\n+#endif /* Py_GIL_DISABLED */\n+\n     PyObject *res = PyObject_Call(boot->func, boot->args, boot->kwargs);\n     if (res == NULL) {\n         if (PyErr_ExceptionMatches(PyExc_SystemExit))"
