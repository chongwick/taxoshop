      "patch": "@@ -0,0 +1,6 @@\n+Fix race condition where threads created by PyGILState_Ensure() could get a\n+duplicate id.\n+\n+This affects consumers of tstate->id like the contextvar caching machinery,\n+which could return invalid cached objects under heavy thread load (observed\n+in embedded scenarios)."
    },
    {
      "sha": "4001c63ff25ee9ea319410797b3de730c145727b",
      "filename": "Python/pystate.c",
      "status": "modified",
      "additions": 1,
      "deletions": 2,
      "changes": 3,
      "blob_url": "https://github.com/python/cpython/blob/b3b9ade4a3d3fe00d933bcd8fc5c5c755d1024f9/Python%2Fpystate.c",
      "raw_url": "https://github.com/python/cpython/raw/b3b9ade4a3d3fe00d933bcd8fc5c5c755d1024f9/Python%2Fpystate.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Python%2Fpystate.c?ref=b3b9ade4a3d3fe00d933bcd8fc5c5c755d1024f9",
      "patch": "@@ -606,13 +606,12 @@ new_threadstate(PyInterpreterState *interp, int init)\n     tstate->context = NULL;\n     tstate->context_ver = 1;\n \n-    tstate->id = ++interp->tstate_next_unique_id;\n-\n     if (init) {\n         _PyThreadState_Init(tstate);\n     }\n \n     HEAD_LOCK(runtime);\n+    tstate->id = ++interp->tstate_next_unique_id;\n     tstate->prev = NULL;\n     tstate->next = interp->tstate_head;\n     if (tstate->next)"
    }
