      "patch": "@@ -0,0 +1 @@\n+Fix a free-threading race in finalization by asserting the thread list is non-empty only after stopping the world."
    },
    {
      "sha": "7ebde15b6b7e259285296a883308af1ceadf0da6",
      "filename": "Python/pylifecycle.c",
      "status": "modified",
      "additions": 1,
      "deletions": 1,
      "changes": 2,
      "blob_url": "https://github.com/python/cpython/blob/fa67e46142dd76842b499fd3fb711c40f7dfdc7d/Python%2Fpylifecycle.c",
      "raw_url": "https://github.com/python/cpython/raw/fa67e46142dd76842b499fd3fb711c40f7dfdc7d/Python%2Fpylifecycle.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Python%2Fpylifecycle.c?ref=fa67e46142dd76842b499fd3fb711c40f7dfdc7d",
      "patch": "@@ -3827,8 +3827,8 @@ handle_thread_shutdown_exception(PyThreadState *tstate)\n     assert(tstate != NULL);\n     assert(_PyErr_Occurred(tstate));\n     PyInterpreterState *interp = tstate->interp;\n-    assert(interp->threads.head != NULL);\n     _PyEval_StopTheWorld(interp);\n+    assert(interp->threads.head != NULL);   /* safe: world is stopped */\n \n     // We don't have to worry about locking this because the\n     // world is stopped."
    }
