      "patch": "@@ -0,0 +1,2 @@\n+Fix data race between interpreter_clear() and take_gil() on eval_breaker\n+during finalization with daemon threads."
    },
    {
      "sha": "c402d89a16145b7acbad664ba5e3f132063d552b",
      "filename": "Python/pystate.c",
      "status": "modified",
      "additions": 4,
      "deletions": 3,
      "changes": 7,
      "blob_url": "https://github.com/python/cpython/blob/059570c40403d2e9058bbd7b17c30f04d7b718fa/Python%2Fpystate.c",
      "raw_url": "https://github.com/python/cpython/raw/059570c40403d2e9058bbd7b17c30f04d7b718fa/Python%2Fpystate.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Python%2Fpystate.c?ref=059570c40403d2e9058bbd7b17c30f04d7b718fa",
      "patch": "@@ -763,10 +763,11 @@ interpreter_clear(PyInterpreterState *interp, PyThreadState *tstate)\n \n     Py_CLEAR(interp->audit_hooks);\n \n-    // At this time, all the threads should be cleared so we don't need atomic\n-    // operations for instrumentation_version or eval_breaker.\n+    // gh-140257: Threads have already been cleared, but daemon threads may\n+    // still access eval_breaker atomically via take_gil() right before they\n+    // hang. Use an atomic store to prevent data races during finalization.\n     interp->ceval.instrumentation_version = 0;\n-    tstate->eval_breaker = 0;\n+    _Py_atomic_store_uintptr(&tstate->eval_breaker, 0);\n \n     for (int i = 0; i < _PY_MONITORING_UNGROUPED_EVENTS; i++) {\n         interp->monitors.tools[i] = 0;"
    }
  ],
