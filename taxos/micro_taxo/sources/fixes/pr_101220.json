      "patch": "@@ -0,0 +1,2 @@\n+Avoid unexpected ``freeaddrinfo`` when :meth:`socket.socket.getaddrinfo`\n+fails. Patch by Sergey G. Brester."
    },
    {
      "sha": "8659d725f2e3a3b08b8b4c52355516754d6e541c",
      "filename": "Modules/socketmodule.c",
      "status": "modified",
      "additions": 2,
      "deletions": 0,
      "changes": 2,
      "blob_url": "https://github.com/python/cpython/blob/65bdee0e6a2b684c58a9dbb6404647a5f021b9a1/Modules%2Fsocketmodule.c",
      "raw_url": "https://github.com/python/cpython/raw/65bdee0e6a2b684c58a9dbb6404647a5f021b9a1/Modules%2Fsocketmodule.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Modules%2Fsocketmodule.c?ref=65bdee0e6a2b684c58a9dbb6404647a5f021b9a1",
      "patch": "@@ -6719,6 +6719,7 @@ socket_getaddrinfo(PyObject *self, PyObject *args, PyObject* kwargs)\n     error = getaddrinfo(hptr, pptr, &hints, &res0);\n     Py_END_ALLOW_THREADS\n     if (error) {\n+        res0 = NULL;  /* avoid unexpected free if res0 becomes not NULL */\n         set_gaierror(error);\n         goto err;\n     }\n@@ -6815,6 +6816,7 @@ socket_getnameinfo(PyObject *self, PyObject *args)\n     error = getaddrinfo(hostp, pbuf, &hints, &res);\n     Py_END_ALLOW_THREADS\n     if (error) {\n+        res = NULL;  /* avoid unexpected free if res becomes not NULL */\n         set_gaierror(error);\n         goto fail;\n     }"
    }
