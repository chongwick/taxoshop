      "patch": "@@ -0,0 +1,3 @@\n+Calling :func:`repr` on :func:`functools.partial` is now safer\n+when the partial object's internal attributes are replaced while\n+the string representation is being generated."
    },
    {
      "sha": "a1682ec4c0ea2204a6ebfd5fac2e99a79bec0e95",
      "filename": "Modules/_functoolsmodule.c",
