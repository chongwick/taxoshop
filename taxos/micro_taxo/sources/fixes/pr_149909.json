      "patch": "@@ -0,0 +1 @@\n+Fix a race condition in ``_PyBytes_FromList`` in free-threading mode."
    },
    {
      "sha": "6dd32b7079a765b059f7c9db0c76d483f76e8a49",
      "filename": "Objects/bytesobject.c",
      "status": "modified",
      "additions": 5,
      "deletions": 2,
      "changes": 7,
      "blob_url": "https://github.com/python/cpython/blob/b2b19e2d1f465168c86b201ed7f867a0cb686125/Objects%2Fbytesobject.c",
      "raw_url": "https://github.com/python/cpython/raw/b2b19e2d1f465168c86b201ed7f867a0cb686125/Objects%2Fbytesobject.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Objects%2Fbytesobject.c?ref=b2b19e2d1f465168c86b201ed7f867a0cb686125",
      "patch": "@@ -11,6 +11,7 @@\n #include \"pycore_global_objects.h\"// _Py_GET_GLOBAL_OBJECT()\n #include \"pycore_initconfig.h\"    // _PyStatus_OK()\n #include \"pycore_long.h\"          // _PyLong_DigitValue\n+#include \"pycore_list.h\"          // _PyList_GetItemRef\n #include \"pycore_object.h\"        // _PyObject_GC_TRACK\n #include \"pycore_pymem.h\"         // PYMEM_CLEANBYTE\n #include \"pycore_strhex.h\"        // _Py_strhex_with_sep()\n@@ -2991,8 +2992,10 @@ _PyBytes_FromList(PyObject *x)\n     size = _PyBytesWriter_GetAllocated(writer);\n \n     for (Py_ssize_t i = 0; i < PyList_GET_SIZE(x); i++) {\n-        PyObject *item = PyList_GET_ITEM(x, i);\n-        Py_INCREF(item);\n+        PyObject *item = _PyList_GetItemRef((PyListObject *)x, i);\n+        if (item == NULL) {\n+            goto error;\n+        }\n         Py_ssize_t value = PyNumber_AsSsize_t(item, NULL);\n         Py_DECREF(item);\n         if (value == -1 && PyErr_Occurred())"
    }
