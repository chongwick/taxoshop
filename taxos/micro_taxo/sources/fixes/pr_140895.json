      "patch": "@@ -677,12 +677,19 @@ faulthandler_is_enabled_impl(PyObject *module)\n     return fatal_error.enabled;\n }\n \n+// TODO: remove\n+static int\n+interp_is_freed(PyInterpreterState *interp)\n+{\n+    return _PyMem_IsPtrFreed(interp);\n+}\n+\n static void\n faulthandler_thread(void *unused)\n {\n     PyLockStatus st;\n     const char* errmsg;\n-    int ok;\n+    int ok = 1;\n #if defined(HAVE_PTHREAD_SIGMASK) && !defined(HAVE_BROKEN_PTHREAD_SIGMASK)\n     sigset_t set;\n \n@@ -703,8 +710,28 @@ faulthandler_thread(void *unused)\n \n         (void)_Py_write_noraise(thread.fd, thread.header, (int)thread.header_len);\n \n-        errmsg = _Py_DumpTracebackThreads(thread.fd, thread.interp, NULL);\n-        ok = (errmsg == NULL);\n+        PyInterpreterState *interp = thread.interp;\n+        assert(interp != NULL);\n+\n+        if (!interp_is_freed(interp)) {\n+\n+            PyThreadState* ts = PyThreadState_New(interp);\n+            if (ts) {\n+                _PyThreadState_Attach(ts);\n+                _PyEval_StopTheWorld(interp);\n+\n+                errmsg = _Py_DumpTracebackThreads(thread.fd, interp, NULL);\n+                ok = (errmsg == NULL);\n+\n+                _PyEval_StartTheWorld(interp);\n+                PyThreadState_Clear(ts);\n+                PyThreadState_DeleteCurrent();\n+            }\n+            else {\n+                fprintf(stderr, \"faulthandler_thread: PyThreadState_New failed\\n\");\n+            }\n+        }\n+\n \n         if (thread.exit)\n             _exit(1);"
