    {
      "sha": "46786d0672b0a838ffe83ed00e775afcdd6ad38c",
      "filename": "Misc/NEWS.d/next/Core and Builtins/2026-02-13-12-00-00.gh-issue-144759.d3qYpe.rst",
      "status": "added",
      "additions": 4,
      "deletions": 0,
      "changes": 4,
      "blob_url": "https://github.com/python/cpython/blob/454fe9d76c1e3546c23da40d961f76ce229691d0/Misc%2FNEWS.d%2Fnext%2FCore%20and%20Builtins%2F2026-02-13-12-00-00.gh-issue-144759.d3qYpe.rst",
      "raw_url": "https://github.com/python/cpython/raw/454fe9d76c1e3546c23da40d961f76ce229691d0/Misc%2FNEWS.d%2Fnext%2FCore%20and%20Builtins%2F2026-02-13-12-00-00.gh-issue-144759.d3qYpe.rst",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Misc%2FNEWS.d%2Fnext%2FCore%20and%20Builtins%2F2026-02-13-12-00-00.gh-issue-144759.d3qYpe.rst?ref=454fe9d76c1e3546c23da40d961f76ce229691d0",
      "patch": "@@ -0,0 +1,4 @@\n+Fix undefined behavior in the lexer when ``start`` and ``multi_line_start``\n+pointers are ``NULL`` in ``_PyLexer_remember_fstring_buffers()`` and\n+``_PyLexer_restore_fstring_buffers()``. The ``NULL`` pointer arithmetic\n+(``NULL - valid_pointer``) is now guarded with explicit ``NULL`` checks."
    },
    {
      "sha": "6815e055d24c60d93e8a2b08435018511af15ba8",
      "filename": "Parser/lexer/buffer.c",
      "status": "modified",
      "additions": 4,
      "deletions": 4,
      "changes": 8,
      "blob_url": "https://github.com/python/cpython/blob/454fe9d76c1e3546c23da40d961f76ce229691d0/Parser%2Flexer%2Fbuffer.c",
      "raw_url": "https://github.com/python/cpython/raw/454fe9d76c1e3546c23da40d961f76ce229691d0/Parser%2Flexer%2Fbuffer.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Parser%2Flexer%2Fbuffer.c?ref=454fe9d76c1e3546c23da40d961f76ce229691d0",
      "patch": "@@ -13,8 +13,8 @@ _PyLexer_remember_fstring_buffers(struct tok_state *tok)\n \n     for (index = tok->tok_mode_stack_index; index >= 0; --index) {\n         mode = &(tok->tok_mode_stack[index]);\n-        mode->f_string_start_offset = mode->f_string_start - tok->buf;\n-        mode->f_string_multi_line_start_offset = mode->f_string_multi_line_start - tok->buf;\n+        mode->f_string_start_offset = mode->f_string_start == NULL ? -1 : mode->f_string_start - tok->buf;\n+        mode->f_string_multi_line_start_offset = mode->f_string_multi_line_start == NULL ? -1 : mode->f_string_multi_line_start - tok->buf;\n     }\n }\n \n@@ -27,8 +27,8 @@ _PyLexer_restore_fstring_buffers(struct tok_state *tok)\n \n     for (index = tok->tok_mode_stack_index; index >= 0; --index) {\n         mode = &(tok->tok_mode_stack[index]);\n-        mode->f_string_start = tok->buf + mode->f_string_start_offset;\n-        mode->f_string_multi_line_start = tok->buf + mode->f_string_multi_line_start_offset;\n+        mode->f_string_start = mode->f_string_start_offset < 0 ? NULL : tok->buf + mode->f_string_start_offset;\n+        mode->f_string_multi_line_start = mode->f_string_multi_line_start_offset < 0 ? NULL : tok->buf + mode->f_string_multi_line_start_offset;\n     }\n }\n "
    }
