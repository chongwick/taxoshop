      "patch": "@@ -0,0 +1,3 @@\n+pymalloc returns memory blocks aligned by 16 bytes, instead of 8 bytes, on\n+64-bit platforms to conform x86-64 ABI. Recent compilers assume this alignment\n+more often. Patch by Inada Naoki."
    },
    {
      "sha": "885ad537ad959d11fc64e4264c1c49aa3b6b3765",
      "filename": "Objects/obmalloc.c",
      "status": "modified",
      "additions": 6,
      "deletions": 0,
      "changes": 6,
      "blob_url": "https://github.com/python/cpython/blob/1b85f4ec45a5d63188ee3866bd55eb29fdec7fbf/Objects%2Fobmalloc.c",
      "raw_url": "https://github.com/python/cpython/raw/1b85f4ec45a5d63188ee3866bd55eb29fdec7fbf/Objects%2Fobmalloc.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Objects%2Fobmalloc.c?ref=1b85f4ec45a5d63188ee3866bd55eb29fdec7fbf",
      "patch": "@@ -788,8 +788,14 @@ static int running_on_valgrind = -1;\n  *\n  * You shouldn't change this unless you know what you are doing.\n  */\n+\n+#if SIZEOF_VOID_P > 4\n+#define ALIGNMENT              16               /* must be 2^N */\n+#define ALIGNMENT_SHIFT         4\n+#else\n #define ALIGNMENT               8               /* must be 2^N */\n #define ALIGNMENT_SHIFT         3\n+#endif\n \n /* Return the number of bytes in size class I, as a uint. */\n #define INDEX2SIZE(I) (((uint)(I) + 1) << ALIGNMENT_SHIFT)"
    }
