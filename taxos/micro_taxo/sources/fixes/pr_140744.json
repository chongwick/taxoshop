      "patch": "@@ -1654,6 +1654,26 @@ def make_pairs():\n                 self.assertEqual(d.get(key3_3), 44)\n                 self.assertGreaterEqual(eq_count, 1)\n \n+    def test_clear_at_lookup(self):\n+        class X:\n+            def __hash__(self):\n+                return 1\n+            def __eq__(self, other):\n+                nonlocal d\n+                d.clear()\n+\n+        d = {}\n+        for _ in range(10):\n+            d[X()] = None\n+\n+        self.assertEqual(len(d), 1)\n+\n+        d = {}\n+        for _ in range(10):\n+            d.setdefault(X(), None)\n+\n+        self.assertEqual(len(d), 1)\n+\n \n class CAPITest(unittest.TestCase):\n "
    },
    {
      "sha": "8fd9b46c0aeabe41ae43e3fdcf5a00d7e21acb17",
      "filename": "Misc/NEWS.d/next/Core and Builtins/2025-10-24-20-42-33.gh-issue-140551.-9swrl.rst",
      "status": "added",
