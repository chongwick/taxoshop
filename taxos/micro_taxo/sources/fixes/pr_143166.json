      "patch": "@@ -2577,7 +2577,12 @@ _collections__count_elements_impl(PyObject *module, PyObject *mapping,\n                 if (_PyDict_SetItem_KnownHash(mapping, key, one, hash) < 0)\n                     goto done;\n             } else {\n+                /* oldval is a borrowed reference.  Keep it alive across\n+                   PyNumber_Add(), which can execute arbitrary user code and\n+                   mutate (or even clear) the underlying dict. */\n+                Py_INCREF(oldval);\n                 newval = PyNumber_Add(oldval, one);\n+                Py_DECREF(oldval);\n                 if (newval == NULL)\n                     goto done;\n                 if (_PyDict_SetItem_KnownHash(mapping, key, newval, hash) < 0)"
