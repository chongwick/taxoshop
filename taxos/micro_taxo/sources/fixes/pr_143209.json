      "sha": "66dc5e22f0ab2331256f9a87137d677c16542702",
      "filename": "Misc/NEWS.d/next/Core_and_Builtins/2025-12-27-10-14-26.gh-issue-143195.MNldfr.rst",
      "status": "added",
