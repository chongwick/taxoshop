      "sha": "7503c3d1dbd3a861a34c37667b809e978b44bb75",
      "filename": "Misc/NEWS.d/next/Core_and_Builtins/2025-12-22-01-09-15.gh-issue-143006.TbNYHd.rst",
      "status": "added",
      "additions": 3,
      "deletions": 0,
      "changes": 3,
      "blob_url": "https://github.com/python/cpython/blob/490cd3fac1e39eb20e5cb2edd37a25b7f740eeab/Misc%2FNEWS.d%2Fnext%2FCore_and_Builtins%2F2025-12-22-01-09-15.gh-issue-143006.TbNYHd.rst",
      "raw_url": "https://github.com/python/cpython/raw/490cd3fac1e39eb20e5cb2edd37a25b7f740eeab/Misc%2FNEWS.d%2Fnext%2FCore_and_Builtins%2F2025-12-22-01-09-15.gh-issue-143006.TbNYHd.rst",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Misc%2FNEWS.d%2Fnext%2FCore_and_Builtins%2F2025-12-22-01-09-15.gh-issue-143006.TbNYHd.rst?ref=490cd3fac1e39eb20e5cb2edd37a25b7f740eeab",
      "patch": "@@ -0,0 +1,3 @@\n+Add missing type check for rich comparison methods of the :class:`float` to\n+avoid possible crash with integer operand, having broken implementation of\n+the :meth:`object.__neg__` method."
    },
    {
      "sha": "3869fe19c37342e183c10fe9b7502ad3e9285a1f",
      "filename": "Objects/floatobject.c",
      "status": "modified",
      "additions": 7,
      "deletions": 0,
      "changes": 7,
      "blob_url": "https://github.com/python/cpython/blob/490cd3fac1e39eb20e5cb2edd37a25b7f740eeab/Objects%2Ffloatobject.c",
      "raw_url": "https://github.com/python/cpython/raw/490cd3fac1e39eb20e5cb2edd37a25b7f740eeab/Objects%2Ffloatobject.c",
      "contents_url": "https://api.github.com/repos/python/cpython/contents/Objects%2Ffloatobject.c?ref=490cd3fac1e39eb20e5cb2edd37a25b7f740eeab",
      "patch": "@@ -473,6 +473,13 @@ float_richcompare(PyObject *v, PyObject *w, int op)\n                 ww = PyNumber_Negative(w);\n                 if (ww == NULL)\n                     goto Error;\n+                else if (!PyLong_Check(ww)) {\n+                    PyErr_Format(PyExc_TypeError,\n+                                 \"unexpected type from negation \"\n+                                 \"of integer operand; expected int, got %T\",\n+                                 ww);\n+                    goto Error;\n+                }\n             }\n             else\n                 Py_INCREF(ww);"
    }
